flowchart TB
  C["İSTEMCİ<br/>Tarayıcı: HTTPS 443<br/>Postman / OpenAPI: HTTP 80 üzerinden API"]
  T["GİRİŞ NOKTASI — TRAEFIK<br/>HTTPS bağlantısını karşılar<br/>HTTP site isteğini 308 ile HTTPS'e yönlendirir<br/>Siteyi frontend'e, /api isteklerini gateway'e iletir"]
  F["FRONTEND — Next.js :3000<br/>Kullanıcının gördüğü ekranlar<br/>Sunucudan API çağrıları: API_INTERNAL_URL"]
  G["API-GATEWAY — Java / Spring :8080<br/>JwtGatewayFilter.java: tokenı doğrular, kimliği header'a ekler<br/>GatewayAccess.java: public / korumalı / admin kontrolü<br/>application.yml: isteği ilgili servise yönlendirir"]

  subgraph SERVICES ["BACKEND SERVİSLERİ — Java / Spring · Docker içinde HTTP"]
    A["AUTH-SERVICE :8081<br/>AuthController.java → AuthServiceImpl.java<br/>Hesabı bulur, şifreyi kontrol eder<br/>JwtServiceImpl.java: USER veya ADMIN tokenı üretir"]
    P["PROPERTY-SERVICE :8082<br/>PropertyController.java → PropertyServiceImpl.java<br/>İlanları oluşturur, okur ve yönetir<br/>İlan sahibinin kullanıcı ID'sini tutar"]
    I["INQUIRY-SERVICE :8083<br/>InquiryController.java → InquiryServiceImpl.java<br/>Mesajı gönderene, ilana ve ilan sahibine bağlar<br/>Durumu admin veya ilgili ilan sahibi değiştirebilir"]
  end

  AD[("auth_db<br/>Hesaplar ve roller")]
  PD[("property_db<br/>İlanlar ve sahipleri")]
  ID[("inquiry_db<br/>Mesajlar ve durumları")]
  K["JWT ANAHTARLARI — jwt-keys<br/>Auth private key ile token imzalar<br/>Gateway public key ile imzayı doğrular"]
  TLS["HTTPS SERTİFİKASI<br/>infra/tls/localhost.crt"]

  C --> T
