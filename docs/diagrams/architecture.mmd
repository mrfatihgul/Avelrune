flowchart LR
  browser["Tarayıcı HTTPS :443"]
  httpSite["HTTP :80 site"]
  postman["Postman / OpenAPI HTTP :80 /api"]

  subgraph edge [Kenar]
    traefik["Traefik"]
  end

  subgraph apps [Uygulama — Docker içi HTTP]
    frontend["frontend Next.js :3000"]
    gateway["api-gateway :8080"]
  end

  subgraph services [Mikroservisler — HTTP]
    auth["auth-service :8081"]
    property["property-service :8082"]
    inquiry["inquiry-service :8083"]
  end

  subgraph data [Veri]
    authDb[(auth_db)]
    propertyDb[(property_db)]
    inquiryDb[(inquiry_db)]
    keys[jwt-keys volume]
    certs["infra/tls localhost.crt"]
  end

  httpSite -->|"308 HTTPS"| traefik
  browser -->|"TLS"| traefik
  certs -.-> traefik
  postman -->|"HTTP /api /docs"| traefik
  traefik -->|"HTTP /"| frontend
  traefik -->|"HTTP /api/**"| gateway

  frontend -->|"SSR API_INTERNAL_URL HTTP"| gateway

  gateway -->|"/api/auth /api/docs/auth"| auth
  gateway -->|"/api/properties /api/agents /api/admin /api/docs/property"| property
  gateway -->|"/api/inquiries /api/docs/inquiries"| inquiry

  auth --> authDb
  auth -->|"private.pem + public.pem"| keys
  property --> propertyDb
  inquiry --> inquiryDb
  inquiry -->|"ilan doğrula"| property
  gateway -->|"public.pem RS256"| keys
