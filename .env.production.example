# Copy to .env.production and fill in the password before starting production.
# This file is separate from the development .env file.
PROD_POSTGRES_USER=avelrune_prod
PROD_POSTGRES_PASSWORD=

# For local production-mode checks. Set the real HTTPS URL and certificate paths
# when deploying to a server. Use port 443 on a dedicated production host.
PROD_SITE_URL=https://localhost:18443
PROD_HTTPS_PORT=18443
PROD_TLS_CERT_PATH=./infra/tls/localhost.crt
PROD_TLS_KEY_PATH=./infra/tls/localhost.key
